# Staging environment TEMPLATE. Every value below is a placeholder --
# there is no staging host running yet, and nothing here is a real
# credential. When a staging host/database/bucket actually exists,
# fill in the real values as GitHub Actions secrets (or your hosting
# provider's own secret manager) and inject them at deploy time,
# rather than editing this file with anything real. This file's job is
# to document the *shape* staging config needs, matching .env.example.

# CHANGEME: real managed Postgres connection string once staging has one
# (e.g. a Supabase/Neon/RDS instance). "soliloquy_staging" as a
# separate database name from prod's, even if they end up on the same
# server, so a staging mistake can't touch real journal data.
DATABASE_URL=postgresql://soliloquy:CHANGEME@staging-db.soliloquy.example.internal:5432/soliloquy_staging

# CHANGEME: real S3-compatible endpoint (Cloudflare R2, Backblaze B2,
# or a staging MinIO instance), separate bucket from prod.
S3_ENDPOINT_URL=https://staging-objects.soliloquy.example.internal
S3_BUCKET=soliloquy-staging
S3_ACCESS_KEY=CHANGEME
S3_SECRET_KEY=CHANGEME

# Still free by default in staging -- no reason to spend real money
# testing that analysis works before prod does.
ANALYZER_PROVIDER=free
OPENROUTER_API_KEY=CHANGEME
GEMINI_API_KEY=CHANGEME
ANTHROPIC_API_KEY=

ANALYSIS_INTERVAL_HOURS=6
ANALYSIS_WINDOW_DAYS=1
SOLILOQUY_DISABLE_SCHEDULER=

# CHANGEME: staging's own Mosquitto (or shared broker with a
# staging-only topic prefix) once one exists. Left disabled below
# until then, so staging doesn't listen for entries that were never
# meant for it.
MQTT_HOST=staging-mqtt.soliloquy.example.internal
MQTT_PORT=1883
MQTT_TOPIC=soliloquy/journal
SOLILOQUY_DISABLE_MQTT=1

# CHANGEME: a real password, and a real fixed secret (`python -c
# "import secrets; print(secrets.token_hex(32))"`) -- required once
# staging is reachable by anyone other than this machine. See
# src/soliloquy/auth.py.
AUTH_PASSWORD=CHANGEME
SESSION_SECRET_KEY=CHANGEME
