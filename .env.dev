# Dev environment. Same shape as .env.example, tracked in git on
# purpose (there's nothing secret in a local docker-compose password
# that never leaves this machine) so `docker compose --env-file
# .env.dev` and the dev pipeline (.github/workflows/deploy-dev.yml)
# have a real file to point at without every contributor recreating
# one by hand. Points at the local docker-compose services from
# docker-compose.yml.

DATABASE_URL=postgresql://soliloquy:soliloquy@localhost:5433/soliloquy

S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=soliloquy
S3_ACCESS_KEY=soliloquy
S3_SECRET_KEY=soliloquy123

# Free by default -- no cost to run analysis in dev.
ANALYZER_PROVIDER=free
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

ANALYSIS_INTERVAL_HOURS=6
ANALYSIS_WINDOW_DAYS=1
SOLILOQUY_DISABLE_SCHEDULER=

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=soliloquy/journal
SOLILOQUY_DISABLE_MQTT=
