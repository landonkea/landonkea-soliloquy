# Production environment TEMPLATE. Every value below is a placeholder
# -- there is no production host running yet, and nothing here is a
# real credential. When a real host/database/bucket exists, fill in
# actual values as GitHub Actions secrets (or your hosting provider's
# secret manager) and inject them at deploy time; never commit a real
# value into this file. This file's job is to document the *shape*
# prod config needs, matching .env.example.

# CHANGEME: real managed Postgres connection string.
DATABASE_URL=postgresql://soliloquy:CHANGEME@prod-db.soliloquy.example.internal:5432/soliloquy

# CHANGEME: real S3-compatible endpoint. Cloudflare R2 is the one
# already discussed in README's Backups section (zero egress fees), so
# it's the likely real choice here, but any S3-compatible provider
# works unchanged since object_storage.py talks the S3 API via boto3.
S3_ENDPOINT_URL=https://objects.soliloquy.example.com
S3_BUCKET=soliloquy-prod
S3_ACCESS_KEY=CHANGEME
S3_SECRET_KEY=CHANGEME

# Free by default here too -- switch to "claude" (and set
# ANTHROPIC_API_KEY) only as a deliberate choice, not a default.
ANALYZER_PROVIDER=free
OPENROUTER_API_KEY=CHANGEME
GEMINI_API_KEY=CHANGEME
ANTHROPIC_API_KEY=

ANALYSIS_INTERVAL_HOURS=6
ANALYSIS_WINDOW_DAYS=1
SOLILOQUY_DISABLE_SCHEDULER=

# CHANGEME: production Mosquitto, reachable from wherever
# makeItSoNumberOne actually runs. Needs real auth/TLS before this
# stops being a placeholder -- see mosquitto/mosquitto.conf's own
# notes and CHECKLIST.md's LAN-hardening section; the anonymous-auth
# posture that's fine on a home LAN is not fine once "production"
# means something reachable beyond it.
MQTT_HOST=mqtt.soliloquy.example.com
MQTT_PORT=1883
MQTT_TOPIC=soliloquy/journal
SOLILOQUY_DISABLE_MQTT=1
