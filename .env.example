# Copy to .env (gitignored) and adjust if you're not using the default
# docker-compose setup, or when pointing at a managed cloud provider later.

DATABASE_URL=postgresql://soliloquy:soliloquy@localhost:5433/soliloquy

S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=soliloquy
S3_ACCESS_KEY=soliloquy
S3_SECRET_KEY=soliloquy123

# Analysis provider: "free" (default, no cost -- OpenRouter free-tagged
# models, falling back to Gemini's free tier) or "claude" (paid).
ANALYZER_PROVIDER=free

# Needed for the "free" provider -- set one or both (a provider with no
# key configured is skipped, not a hard failure).
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Only needed if ANALYZER_PROVIDER=claude.
ANTHROPIC_API_KEY=

# How often the web app runs analysis automatically in the background
# (see /analysis), and over how many days of entries each run covers.
# This cadence is a starting point, not tuned yet -- see CHECKLIST.md.
ANALYSIS_INTERVAL_HOURS=6
ANALYSIS_WINDOW_DAYS=1

# Set to "1" to disable the background scheduler entirely (used by the
# test suite).
SOLILOQUY_DISABLE_SCHEDULER=

# MQTT broker the web app listens on for voice-triggered journal
# entries (see mqtt_bridge.py) -- pairs with landonkea-makeItSoNumberOne's
# journal_entry plugin. Defaults match the local docker-compose Mosquitto.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=soliloquy/journal

# Set to "1" to disable the MQTT listener entirely (used by the test suite).
SOLILOQUY_DISABLE_MQTT=

# Single-user password gate (see src/soliloquy/auth.py). Leave blank
# for local dev on your own machine -- every page and API route is
# reachable with no login when this is unset, and a startup log line
# says so. Set a real password here before this is reachable from
# anywhere less trusted than your own machine (another device on your
# LAN, let alone the internet).
AUTH_PASSWORD=

# Signs the login session cookie AND report share links (see
# report_store.py). Only matters when AUTH_PASSWORD is set, or when
# you want to create a shareable report link -- generate one with
# `python -c "import secrets; print(secrets.token_hex(32))"` and keep
# it fixed, so logging in (and any share links you've handed out)
# survive an app restart instead of breaking. Left unset, a random one
# is generated each process start, which still works for login, it
# just logs everyone out on every restart and invalidates share links.
SESSION_SECRET_KEY=

# Encrypts the transcript column at rest (see storage.py's module
# docstring for exactly how, and its real limits). Off by default --
# leave blank unless you specifically want this. Generate one with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`.
# Turning this on only affects entries written AFTER it's set; run
# scripts/encrypt_existing_transcripts.py once, deliberately, to
# encrypt anything already in the database.
TRANSCRIPT_ENCRYPTION_KEY=

# Opt-in: auto-delete audio/video (never the transcript) from object
# storage once an entry is this many days old, to keep MinIO/R2
# storage growth in check. Unset (the default) means keep media
# forever.
MEDIA_RETENTION_DAYS=
